{
  "name": "@deepseek-ai/dsh-sci-profile",
  "description": "The dsh-sci bundle: the science-research patch layer over dsh-base + dsh-web-app, its two shipped agent presets, and the six subagent persona charters",
  "version": "0.1.1-rc.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sci/sci-profile"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "config/**",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-presets": "workspace:^",
    "@deepseek-ai/dsh-client-ui-brand-sci": "workspace:^",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sci-conversation": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sci-files": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sci-library": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sci-citations": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sci-search": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sci-shell": "workspace:^",
    "@deepseek-ai/dsh-dormice": "workspace:^",
    "@deepseek-ai/dsh-fs-e2b": "workspace:^",
    "@deepseek-ai/dsh-host-directory-picker-e2b": "workspace:^",
    "@deepseek-ai/dsh-office-univer": "workspace:^",
    "@deepseek-ai/dsh-persona": "workspace:^",
    "@deepseek-ai/dsh-sci-audit": "workspace:^",
    "@deepseek-ai/dsh-sci-credit": "workspace:^",
    "@deepseek-ai/dsh-camel-runtime": "workspace:^",
    "@deepseek-ai/dsh-sci-deliver": "workspace:^",
    "@deepseek-ai/dsh-sci-guard": "workspace:^",
    "@deepseek-ai/dsh-sci-library": "workspace:^",
    "@deepseek-ai/dsh-sci-citations": "workspace:^",
    "@deepseek-ai/dsh-sci-literature": "workspace:^",
    "@deepseek-ai/dsh-sci-memory": "workspace:^",
    "@deepseek-ai/dsh-sci-plan": "workspace:^",
    "@deepseek-ai/dsh-sci-prompt": "workspace:^",
    "@deepseek-ai/dsh-sci-remote-hosts": "workspace:^",
    "@deepseek-ai/dsh-sci-skills": "workspace:^",
    "@deepseek-ai/dsh-sci-tier": "workspace:^",
    "@deepseek-ai/dsh-sci-workspace": "workspace:^",
    "@deepseek-ai/dsh-subprocess-e2b": "workspace:^",
    "@deepseek-ai/dsh-tool-ask-user": "workspace:^",
    "@deepseek-ai/dsh-web-fetch-http": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
